; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sari-Saring Katha"
run/main_scene="res://Scenes/MainGame.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputManager="*res://Scripts/InputManager.gd"
DragManager="*res://Scripts/DragManager.gd"
DialogueManager="*uid://c3rodes2l3gxb"
InventoryManager="*res://Scripts/InventoryManager.gd"
GDRx="*uid://53t8o3elg2rt"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"KuyaKap": "res://Characters/KuyaKap.dch",
"Timelines/KuyaKap": "res://Dialogue/Timelines/KuyaKap.dch"
}
directories/dtl_directory={
"customer_greeting": "res://Dialogue/customer_greeting.dtl",
"customer_rejected": "res://Dialogue/customer_rejected.dtl",
"customer_returning": "res://Dialogue/customer_returning.dtl",
"customer_satisfied": "res://Dialogue/customer_satisfied.dtl",
"day_ended": "res://Dialogue/day_ended.dtl",
"main_timeline": "res://Dialogue/Timelines/main_timeline.dtl"
}
layout/style_directory={
"": "res://Assets/Dialogue/DialogueStyle.tres",
"DialogueStyle": "res://Assets/Dialogue/DialogueStyle.tres"
}
layout/style_list=["res://Assets/Dialogue/DialogueStyle.tres"]
layout/default_style="res://Assets/Dialogue/DialogueStyle.tres"
glossary/default_case_sensitive=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/instant-realistic-light/plugin.cfg", "res://addons/reactivex/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

