# Rosalyn - Unified Post-Arc Purchase Timeline (3-Slot Sandwich Pattern)
# Unlocks ONLY after Chapter 6 (purchase_only_on_final_chapter = true).
# Voice: Painfully shy, hushed 3-to-8 word fragments. Zero [pause] or [wave] spam.

label Greeting
if {Transaction_HasReactiveOpener}:
	Rosalyn: {Transaction_ReactiveOpener}
elif {Global_HighPriceActive}:
	Rosalyn: Cost less in Lola's time, po.

if {Flag_RosalynAtPeace}:
	if {Transaction_GreetingVar} < 25:
		Rosalyn: Coins stayed flat, po. [color=#0f6e2f]{Transaction_ItemWants}[/color], please?
	elif {Transaction_GreetingVar} < 50:
		Rosalyn: Warm bulb, po. [color=#0f6e2f]{Transaction_ItemWants}[/color], please?
	elif {Transaction_GreetingVar} < 75:
		Rosalyn: Hands feel steady, po. [color=#0f6e2f]{Transaction_ItemWants}[/color]?
	else:
		Rosalyn: Quiet road, po. May I get [color=#0f6e2f]{Transaction_ItemWants}[/color]?
else:
	if {Transaction_GreetingVar} < 25:
		Rosalyn: Hello, po. [color=#0f6e2f]{Transaction_ItemWants}[/color], please?
	elif {Transaction_GreetingVar} < 50:
		Rosalyn: Coins on the wood, po. [color=#0f6e2f]{Transaction_ItemWants}[/color]?
	elif {Transaction_GreetingVar} < 75:
		Rosalyn: Focusing hard, po. [color=#0f6e2f]{Transaction_ItemWants}[/color], please?
	else:
		Rosalyn: Sorry to bother, po. [color=#0f6e2f]{Transaction_ItemWants}[/color]?
[end_timeline]

label Talk
Rosalyn: No rush, po. Waiting on [color=#0f6e2f]{Transaction_ItemWants}[/color].
- Coming right up, Rosalyn.
	[end_timeline]
- Sorry, we're out of stock.
	Rosalyn: Alright, po. Next visit.
	[signal arg="refuse_service"]
	[end_timeline]

label Partial
set {Variation} = range(1,4).pick_random()
if {Variation} == 1.0:
	Rosalyn: Got it, po. Still [color=#0f6e2f]{Transaction_ItemWants}[/color].
elif {Variation} == 2.0:
	Rosalyn: Holding steady, po. Still [color=#0f6e2f]{Transaction_ItemWants}[/color].
else:
	Rosalyn: Thank you, po. Just [color=#0f6e2f]{Transaction_ItemWants}[/color].
[end_timeline]

label Satisfy
if {Global_TipActive}:
	Rosalyn: Extra coins for the light, po.
elif {Transaction_SatisfyVar} < 34:
	Rosalyn: Solid and cool. Salamat po.
elif {Transaction_SatisfyVar} < 67:
	Rosalyn: Didn't drop it, po. Salamat.
else:
	Rosalyn: Thank you, po.
[signal arg="story_success"]
[end_timeline]

label Repayment
Rosalyn: {Transaction_RepaymentAmount} pesos from your lista, po.
- Thank you, Rosalyn.
	[signal arg="repay_debt"]
	Rosalyn: Salamat po.
[end_timeline]

label WrongItem
Rosalyn: Sorry, po. Asked for [color=#0f6e2f]{Transaction_ItemWants}[/color].
[end_timeline]
