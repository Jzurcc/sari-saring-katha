label Greeting
# [signal arg="refresh_desires"]
if {Transaction_GreetingVar} <= 50:
	Rosalyn: [wave]H... [pause=1.0] hello... [pause=1.0] um... [pause=1.0] could I...[/wave]
else:
	Rosalyn: [wave]Good day... [pause=1.0] I... [pause=1.0] I have coins today.[/wave]

if {Global_HighPriceActive}:
	Rosalyn: [wave]Ang bigat naman po yata ng halaga nito ngayon... [pause=0.4] Parang dati mas madaling makuha.[/wave]

[end_timeline]

label Talk
if {Transaction_TalkVar} <= 50:
	Rosalyn: [wave]I would like a {Transaction_ItemWants}... [pause=1.0] if that's okay.[/wave]
else:
	Rosalyn: [wave]Could you spare a {Transaction_ItemWants}? [pause=1.0] I... [pause=1.0] I think I can hold it.[/wave]
- Just a moment, I'm finding it.
	Rosalyn: [wave]Oh... [pause=1.0] um... [pause=1.0] okay. [pause=1.0] I can wait. [pause=1.0] I have... [pause=1.0] plenty of time.[/wave]
	[end_timeline]
- Sorry, Rosalyn, we're fresh out of stock.
	Rosalyn: [wave]Oh... [pause=1.0] I see. [pause=1.0] I'm sorry for asking. [pause=1.0] Goodbye.[/wave]
	[signal arg="refuse_service"]
	[signal arg="story_success"]
	[end_timeline]

label Partial
Rosalyn: [wave]Thank you... [pause=1.0] um... [pause=1.0] I still need a {Transaction_ItemWants} as well.[/wave]
[end_timeline]

label Satisfy
if {Transaction_SatisfyVar} <= 50:
	Rosalyn: [wave]Oh... [pause=1.0] thank you. [pause=1.0] It's... [pause=1.0] it's very solid.[/wave]
else:
	Rosalyn: [wave]I have it. [pause=1.0] It's... [pause=1.0] it's warm. [pause=1.0] Thank you.[/wave]
[end_timeline]

label WrongItem
if {Transaction_WrongItemVar} <= 50:
	Rosalyn: [wave]Oh... [pause=1.0] I don't think this is it. [pause=1.0] I'm sorry.[/wave]
else:
	Rosalyn: [wave]Um... [pause=1.0] this isn't quite what I... [pause=1.0] um... [pause=1.0] practice for.[/wave]
[end_timeline]
