label Greeting
if {Transaction_VisitVar} <= 50:
	Rosalyn: [wave]Your lights... [pause=1.0] they're very bright tonight.[/wave]
	Rosalyn: [wave]I like to just... [pause=1.0] sit near them for a while. [pause=1.0] If that's okay. [pause=1.0] It makes the road feel... [pause=1.0] less empty.[/wave]
else:
	Rosalyn: [wave]I saw a cat outside... [pause=1.0] it looked at me. [pause=1.0][/wave]
	Rosalyn: [wave]Most things don't look. [pause=1.0] Thank you for... [pause=1.0] um... [pause=1.0] keeping the door open.[/wave]
[signal arg="story_success"]
[end_timeline]
