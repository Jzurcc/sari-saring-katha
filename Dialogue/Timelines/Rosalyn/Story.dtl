label Greeting
if {Transaction_Chapter} == 0.0:
	# Chapter 1: "The Flight"
	Rosalyn: [wave].[pause=1.0].[pause=1.0].[pause=1.0][/wave]
	Rosalyn: [wave]H[pause=1.0]-hello.[pause=0.6].[pause=0.6].[pause=1.0][/wave]
	Rosalyn: [wave]I.[pause=0.6].[pause=0.6]. [pause=1.0]um.[/wave]
	Rosalyn: [wave].[pause=0.6].[pause=0.6].[pause=1.0][/wave]
	[signal arg="story_success"]
	[end_timeline]

elif {Transaction_Chapter} == 1.0:
	# Chapter 2: "The Attempt"
	Rosalyn: [wave]H-hello again... [pause=1.0] um.[pause=0.6].[pause=0.6].[/wave]
	Rosalyn: [wave]I.[pause=0.6].[pause=0.6]. [pause=1.0] I brought coins this time... [pause=1.0] see?[/wave]
	Rosalyn: [wave].[pause=0.6].[pause=0.6].[pause=1.0][/wave]
	Rosalyn: [wave]oh.[/wave]
	Rosalyn: [wave]They just passed straight through my hands.[pause=0.6].[pause=0.6].[/wave]
	Rosalyn: [wave]I'm sorry... [pause=0.6] over the mess. [pause=1.0] I can't... [pause=1.0] pick them up.[/wave]
	Rosalyn: [wave]I should go. [pause=1.0] I'll... [pause=1.0] try again tomorrow.[/wave]
	[signal arg="story_success"]
	[end_timeline]

elif {Transaction_Chapter} == 2.0:
	# Chapter 3: "The Anchor"
	Rosalyn: [wave]Good day.[pause=0.6].[pause=0.6]. [pause=1.0][/wave]
	Rosalyn: [wave]May I... [pause=1.0] try again? [pause=1.0] A {Transaction_ItemWants}, please.[/wave] 
	Rosalyn: [wave]Cold... [pause=1.0] if you have it.[/wave]
	Rosalyn: [wave]Let me just... [pause=1.0] one coin... [pause=1.0] two...[/wave]
	Rosalyn: [wave]They stayed. [pause=1.0] On the counter.[/wave] 
	Rosalyn: [wave]It takes so much... [pause=1.0] concentration.[/wave]
	Rosalyn: [wave]The cold helps. [pause=1.0] It gives my hands something to remember.[/wave]
	Rosalyn: [wave]Thank you for your patience.[/wave]
	[end_timeline]

elif {Transaction_Chapter} == 3.0:
	# Chapter 4: "The Burn"
	Rosalyn: [wave]Good day. [pause=1.0] Could I have a hot coffee today?[/wave] 
	Rosalyn: [wave]Actually... [pause=1.0] um... [pause=1.0][/wave]
	Rosalyn: [wave]...No. [pause=1.0] Last Tuesday... [pause=1.0] I tried to hold a warm cup elsewhere.[/wave]
	Rosalyn: [wave]My hand still couldn't feel the warmth. [pause=1.0] Just... [pause=1.0] the shape.[/wave] 
	Rosalyn: [wave]I'll just take a cold {Transaction_ItemWants} instead, please. [pause=1.0] I know that works.[/wave]
	[end_timeline]

elif {Transaction_Chapter} == 4.0:
	# Chapter 5: "The Silence"
	Rosalyn: [wave]Good day. [pause=1.0] I didn't bring coins tonight. [pause=1.0] I just wanted to... [pause=1.0] stand here.[/wave]
	Rosalyn: [wave]The highway outside is so brightly lit... [pause=1.0] but there is no sound.[/wave] 
	Rosalyn: [wave]The cars just... [pause=1.0] push right through.[/wave] 
	Rosalyn: [wave]But earlier... [pause=1.0] a stray cat stopped to look at me.[/wave] 
	Rosalyn: [wave]It didn't run away. [pause=1.0] Just... [pause=1.0] looked.[/wave]
	Rosalyn: [wave]I just wanted to tell someone who could actually see me.[/wave] 
	[signal arg="story_success"]
	[end_timeline]

elif {Transaction_Chapter} == 5.0:
	# Chapter 6: "The Puddle"
	Rosalyn: [wave]I only came to visit tonight. [pause=1.0][/wave]
	Rosalyn: [wave]I stood by a puddle on the shoulder of the road.[/wave] 
	Rosalyn: [wave]I tried to look down... [pause=1.0] to find myself in the water.[/wave] 
	Rosalyn: [wave]There was nothing. [pause=1.0] Just the streetlamp reflecting back.[/wave]
	Rosalyn: [wave]But looking at it... [pause=1.0] I remembered the rain.[/wave]
	Rosalyn: [wave]A blinding light. [pause=1.0] A loud screech of tires... [pause=1.0] and then... [pause=1.0][/wave]
	Rosalyn: [wave]...Nothing.[/wave]
	Rosalyn: [wave]I keep coming back to that rain.[/wave]
	[signal arg="story_success"]
	[end_timeline]

elif {Transaction_Chapter} == 6.0:
	# Chapter 7: "The Candy"
	Rosalyn: [wave]Good day. [pause=1.0] Could I have one of the {Transaction_ItemWants}, please?[/wave]
	Rosalyn: [wave]The menthol ones.[/wave] 
	Rosalyn: [wave]One coin... [pause=1.0] two. [pause=1.0] There.[/wave] 
	Rosalyn: [wave]It feels familiar. [pause=1.0] The smell... [pause=1.0] the coldness on the tongue.[/wave]
	Rosalyn: [wave]I used to stare at your store's lights from the road. [pause=1.0] They always looked so warm.[/wave] 
	Rosalyn: [wave]I'm glad I finally stepped inside.[/wave]
	[end_timeline]

elif {Transaction_Chapter} == 7.0:
	# Chapter 8: "Letting Go"
	Rosalyn: [wave]The candy... [pause=1.0] from last time.[/wave] 
	Rosalyn: [wave]Ramon used to carry them. [pause=1.0] He said they kept him awake on long drives.[/wave] 
	Rosalyn: [wave]We were supposed to meet... [pause=1.0] I was running late. [pause=1.0] I ran across the road without looking, and— [pause=1.5][/wave]
	Rosalyn: [wave]...I don't think he's waiting for me anymore.[/wave] 
	Rosalyn: [wave]He's probably lived a whole life by now. [pause=1.0] I shouldn't keep waiting either.[/wave]
	Rosalyn: [wave]Your lights really helped me realize that. [pause=1.0] Thank you.[/wave]
	[signal arg="story_success"]
	[end_timeline]

elif {Transaction_Chapter} == 8.0:
	# Chapter 9: "The Departure"
	Rosalyn: [wave]I won't be staying tonight. [pause=1.0] I just wanted to say goodbye.[/wave]
	Rosalyn: [wave]You have a very kind heart. [pause=1.0] To listen to someone like me.[/wave] 
	Rosalyn: [wave]Please... [pause=1.0] keep your lights warmly lit. [pause=1.0] It helps the lost ones find their way out of the dark.[/wave]
	Rosalyn: [wave]Goodbye... [pause=1.0] and thank you.[/wave]
	[signal arg="story_success"]
	[end_timeline]

label Talk
Rosalyn: [wave]Oh... [pause=1.0] um... [pause=1.0] I can wait. [pause=1.0] I have... [pause=1.0] plenty of time.[/wave]
Rosalyn: [wave]I just need {Transaction_ItemWants}...[/wave]
- I'll be quick.
	[end_timeline]
- Sorry, we're out.
	Rosalyn: [wave]Oh... [pause=1.0] I see. [pause=1.0] I'm sorry for asking. [pause=1.0] Goodbye.[/wave]
	[signal arg="refuse_service"]
	[signal arg="story_success"]
	[end_timeline]

label Satisfy
Rosalyn: [wave]Oh! [pause=1.0] Thank you. [pause=1.0] It... [pause=1.0] um... [pause=1.0] it feels very real.[/wave]
[signal arg="story_success"]
[end_timeline]

label WrongItem
Rosalyn: [wave]Um... [pause=1.0] I don't think this is the {Transaction_ItemWants}.[/wave] 
Rosalyn: [wave]I'm sorry. [pause=1.0] Maybe I... [pause=1.0] um... [pause=1.0] I'll wait.[/wave]
[end_timeline]