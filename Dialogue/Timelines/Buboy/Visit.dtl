label Greeting
if {Transaction_VisitVar} <= 50:
	Buboy: Vroom! Vroom! [pause=0.4] 
	Buboy: Did you see how fast I was? I ran all the way from the big mango tree!
	Buboy: I'm just catching my breath. Hah... hah... okay! Bye!
else:
	Buboy: Hihi! Look what I found near the tricycle stand! [pause=0.6] 
	Buboy: It's a shiny bottle cap! It's mine now. Treasure! [pause=0.4]
	Buboy: See you later, Boss! Vroom!
[signal arg="dismiss"]
[end_timeline]

