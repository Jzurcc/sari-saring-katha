# T.K. - Unified Everyday Purchase Timeline (3-Slot Sandwich Pattern)
# Shifts ONLY on meaningful story flags (Flag_TKTrailWarden / Flag_TKSubHydrate).
# Voice: Buff, upbeat modern-life-loving Tikbalang adventurer. Zero time-of-day words. Zero em-dashes.

label Greeting
# Slot 1: P1-P3 Reactive Opener or High-Price Remark
if {Transaction_HasReactiveOpener}:
	TK: {Transaction_ReactiveOpener}
elif {Global_HighPriceActive}:
	TK: Whoa, steep climb on those prices, boss! Hope my coin pouch survives this lap!

# Slot 2: Upfront Utang Ask OR Flag-Driven Request Pool (4 grounded variations per state)
if {Transaction_WantsDebt}:
	TK: Uy, boss, minor gear mishap! Jogged over for [color=#0f6e2f]{Transaction_ItemWants}[/color] and left my wallet in my hiking pack!
	TK: Put it on your lista for me? I'll sprint right back with cash on my next pass!
	- Sure T.K., on the lista.
		[signal arg="utang_accepted"]
		TK: Lifesaver, boss! Pass over [color=#0f6e2f]{Transaction_ItemWants}[/color] whenever your hands are free!
	- Sorry T.K., register's tight right now.
		[signal arg="utang_rejected"]
		TK: Fair enough, boss! Extra sprint home for my wallet counts as bonus cardio!
elif {Flag_TKTrailWarden}:
	if {Transaction_GreetingVar} < 25:
		TK: Uy, boss! Zero wrong turns getting here! Hook me up with [color=#0f6e2f]{Transaction_ItemWants}[/color]!
	elif {Transaction_GreetingVar} < 50:
		TK: Just guided a lost parcel rider past the balete! Pass me [color=#0f6e2f]{Transaction_ItemWants}[/color], boss!
	elif {Transaction_GreetingVar} < 75:
		TK: Nokia stayed in my pocket the whole run! Let me grab [color=#0f6e2f]{Transaction_ItemWants}[/color], boss!
	else:
		TK: Base camp refuel! Got [color=#0f6e2f]{Transaction_ItemWants}[/color] ready behind the counter, boss?
elif {Flag_TKSubHydrate}:
	if {Transaction_GreetingVar} < 25:
		TK: Clean lungs, strong stride! Pass me [color=#0f6e2f]{Transaction_ItemWants}[/color], boss!
	elif {Transaction_GreetingVar} < 50:
		TK: Zero smoke, pure stamina! Let me grab [color=#0f6e2f]{Transaction_ItemWants}[/color] for the road, boss!
	elif {Transaction_GreetingVar} < 75:
		TK: Shaved a full minute off my ridge lap! Got [color=#0f6e2f]{Transaction_ItemWants}[/color] on hand, boss?
	else:
		TK: Uy, boss! Stopping by Home Pin Number One for [color=#0f6e2f]{Transaction_ItemWants}[/color]!
else:
	if {Transaction_GreetingVar} < 25:
		TK: Uy, boss! Five bars on the Nokia and zero detours! Pass me [color=#0f6e2f]{Transaction_ItemWants}[/color]!
	elif {Transaction_GreetingVar} < 50:
		TK: Just wrapped a heavy set down the road! Let me grab [color=#0f6e2f]{Transaction_ItemWants}[/color], boss!
	elif {Transaction_GreetingVar} < 75:
		TK: Best cooler in Karimlan! Got [color=#0f6e2f]{Transaction_ItemWants}[/color] ready, boss?
	else:
		TK: Quick pit stop before the Kalumpang trailhead! [color=#0f6e2f]{Transaction_ItemWants}[/color] please, boss!
[end_timeline]

label Talk
TK: Take your time, boss! Still looking for [color=#0f6e2f]{Transaction_ItemWants}[/color] while I catch my breath!
- Coming right up, T.K.
	[end_timeline]
- Sorry T.K., we're out of stock.
	TK: Aw, sayang! All good, boss, I'll check back after your next delivery!
	[signal arg="refuse_service"]
	[end_timeline]

label Partial
set {Variation} = range(1,4).pick_random()
if {Variation} == 1.0:
	TK: Solid! Still waiting on [color=#0f6e2f]{Transaction_ItemWants}[/color] for my pack, boss!
elif {Variation} == 2.0:
	TK: Got that stowed! Just [color=#0f6e2f]{Transaction_ItemWants}[/color] left whenever you're free!
else:
	TK: Nice! No rush on [color=#0f6e2f]{Transaction_ItemWants}[/color], boss, stretching my shoulders!
[end_timeline]

label Satisfy
if {Transaction_WantsDebt}:
	TK: Salamat, boss! Put T.K. right on that lista, cash coming next run!
else:
	if {Global_TipActive}:
		TK: Solid price, boss! Keep the change, appreciate the fair deal!
	elif {Transaction_SatisfyVar} < 34:
		TK: Boom, fuel topped off! Catch you on my next lap, boss!
	elif {Transaction_SatisfyVar} < 67:
		TK: Salamat, boss! Best pit stop on the map!
	else:
		TK: Ready for another five kilometers! Take care behind that counter, boss!
[signal arg="story_success"]
[end_timeline]

label Repayment
TK: First up, boss, grabbed my wallet! Here's the {Transaction_RepaymentAmount} pesos from my lista!
- Thanks, T.K. All squared up!
	[signal arg="repay_debt"]
	TK: Clean slate, boss! Feels great settling up fair and square!
- Keep it, T.K. On the house!
	[signal arg="forgive_debt"]
	TK: Wait, seriously?! Grabe, boss, let me haul your next heavy delivery crate for free!
- No rush, T.K. Pay next pass.
	[signal arg="defer_repay"]
	TK: Solid as always, boss! Tying a knot in my pack strap so I don't forget!
[end_timeline]

label WrongItem
TK: Whoa, wrong turn on the shelf, boss! I asked for [color=#0f6e2f]{Transaction_ItemWants}[/color]!
[end_timeline]
