# Sarimanok - Unified Social Visit & Awning Perch Timeline
# Voice (Approved Exception): Ba-kawk! variations ONLY + punchy, playful parentheticals.

label Greeting
if {Transaction_HasReactiveOpener}:
	Sarimanok: {Transaction_ReactiveOpener}
if {Transaction_VisitVar} < 34:
	Sarimanok: Ba-kawk. (Checks its reflection in the candy jar. Fixes one crooked crest feather.)
	Sarimanok: Ba-kawk! (Glares a noisy tricycle down the road until it leaves.)
elif {Transaction_VisitVar} < 67:
	Sarimanok: [shake]Ba-kawk![/shake] (Hops beside the register, ignores every shelf, and claims the shade.)
	Sarimanok: ba-kawk. (Nudges a slightly crooked jar half an inch straighter.)
else:
	Sarimanok: ba-kawk. (Tucks behind the jars with its bright tail hidden from the street.)
	Sarimanok: Ba-kawk. (Slow royal blink. Official no-photo zone declared.)
[signal arg="story_success"]
[end_timeline]

label Smalltalk
if {Transaction_VisitVar} < 34:
	Sarimanok: Ba-kawk. (Shakes out its golden plumage once and launches to the roofs.)
elif {Transaction_VisitVar} < 67:
	Sarimanok: [shake]Ba-kawk![/shake] (Leaves a tiny trail of gold dust and glides off.)
else:
	Sarimanok: ba-kawk. (One brief, dignified crest nod before swooping out.)
[end_timeline]
