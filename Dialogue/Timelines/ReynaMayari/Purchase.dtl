label Greeting
if {Transaction_HasReactiveOpener}:
	ReynaMayari: {Transaction_ReactiveOpener}

set {Variation} = range(1,5).pick_random()
if {Flag_MayariQueenAtCounter}:
	if {Variation} == 1.0:
		ReynaMayari: Keep your voice low, shopkeeper. Slide me [color=#0f6e2f]{Transaction_ItemWants}[/color] before my Council notices the throne is empty.
	elif {Variation} == 2.0:
		ReynaMayari: Real mortal pesos, counted twice. Pass over [color=#0f6e2f]{Transaction_ItemWants}[/color], and yes, I am staying to chat for a minute.
	elif {Variation} == 3.0:
		ReynaMayari: Biringan's silver banquets are spotless and dull. I would much rather have [color=#0f6e2f]{Transaction_ItemWants}[/color] from your counter.
	else:
		ReynaMayari: Just ordinary Maria again, conducting vital research on [color=#0f6e2f]{Transaction_ItemWants}[/color].
else:
	if {Variation} == 1.0:
		ReynaMayari: Strictly an unscheduled royal inspection. Also, sell me [color=#0f6e2f]{Transaction_ItemWants}[/color] while nobody is looking.
	elif {Variation} == 2.0:
		ReynaMayari: Act completely normal, shopkeeper. Just pass over [color=#0f6e2f]{Transaction_ItemWants}[/color] for "Maria."
	elif {Variation} == 3.0:
		ReynaMayari: Biringan requires a sample of mortal provisions. Specifically [color=#0f6e2f]{Transaction_ItemWants}[/color]. Purely official, of course.
	else:
		ReynaMayari: Real pesos in hand, zero balete leaves. Sell me [color=#0f6e2f]{Transaction_ItemWants}[/color], quickly please.
[end_timeline]

label Talk
ReynaMayari: I am still waiting on [color=#0f6e2f]{Transaction_ItemWants}[/color], shopkeeper.
- Out of stock right now.
	ReynaMayari: Empty? Truly tragic. Call your uncle soon, before my sweet tooth files a royal grievance.
	[signal arg="refuse_service"]
- Grabbing it right away!
	ReynaMayari: Splendid. Take your time, I actually enjoy listening to your street chatter.
[end_timeline]

label Partial
set {Variation} = range(1,4).pick_random()
if {Variation} == 1.0:
	ReynaMayari: Good. I still need [color=#0f6e2f]{Transaction_ItemWants}[/color] to complete my research.
elif {Variation} == 2.0:
	ReynaMayari: Halfway there. Pass over [color=#0f6e2f]{Transaction_ItemWants}[/color] as well, please.
else:
	ReynaMayari: Almost done. Just add [color=#0f6e2f]{Transaction_ItemWants}[/color] before I head back.
[end_timeline]

label Satisfy
if {Global_TipActive} == 1.0:
	ReynaMayari: Keep the extra coins, shopkeeper. Consider it royal funding for your snack shelves.
else:
	if {Transaction_SatisfyVar} < 34.0:
		ReynaMayari: Splendid. Remember, you only served "Maria" from two streets over.
	elif {Transaction_SatisfyVar} < 67.0:
		ReynaMayari: Exactly what I craved. Keep that jar stocked and do not overwork yourself, understood?
	else:
		ReynaMayari: Cheap mortal sweets beat silver banquets every single time. See you soon, shopkeeper.
[signal arg="story_success"]
[end_timeline]

label Repayment
ReynaMayari: Here are your [color=#0f6e2f]{Transaction_RepaymentAmount}[/color] pesos. Cross Maria off the lista cleanly.
[signal arg="repay_debt"]
[end_timeline]

label WrongItem
ReynaMayari: That is not [color=#0f6e2f]{Transaction_ItemWants}[/color]. Try again, shopkeeper.
[end_timeline]
