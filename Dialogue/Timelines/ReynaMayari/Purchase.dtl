label Greeting
if {Transaction_HasReactiveOpener}:
	ReynaMayari: {Transaction_ReactiveOpener}

set {Variation} = range(1,5).pick_random()
if {Flag_MayariQueenAtCounter}:
	if {Variation} == 1.0:
		ReynaMayari: Keep the disguise secret, shopkeeper. Hand over [color=#0f6e2f]{Transaction_ItemWants}[/color] before my Council notices I slipped out.
	elif {Variation} == 2.0:
		ReynaMayari: Real mortal pesos ready. Pass me [color=#0f6e2f]{Transaction_ItemWants}[/color], please.
	elif {Variation} == 3.0:
		ReynaMayari: Biringan's banquets still cannot beat your shelves. Sell me [color=#0f6e2f]{Transaction_ItemWants}[/color].
	else:
		ReynaMayari: Just Maria from two streets over, looking for [color=#0f6e2f]{Transaction_ItemWants}[/color].
else:
	if {Variation} == 1.0:
		ReynaMayari: Strictly a routine daytime inspection. Sell me [color=#0f6e2f]{Transaction_ItemWants}[/color] while I am here.
	elif {Variation} == 2.0:
		ReynaMayari: Act natural, shopkeeper. Just pass over [color=#0f6e2f]{Transaction_ItemWants}[/color].
	elif {Variation} == 3.0:
		ReynaMayari: I am sampling local inventory for Biringan's records. Hand over [color=#0f6e2f]{Transaction_ItemWants}[/color].
	else:
		ReynaMayari: Real pesos in hand, zero balete leaves. Sell me [color=#0f6e2f]{Transaction_ItemWants}[/color].
[end_timeline]

label Talk
ReynaMayari: I am still waiting on [color=#0f6e2f]{Transaction_ItemWants}[/color], shopkeeper.
- Out of stock right now.
	ReynaMayari: A pity. Restock soon, before my sweet tooth files a formal complaint.
	[signal arg="refuse_service"]
- Grabbing it right away!
	ReynaMayari: Splendid. I have five minutes before anyone misses me in Biringan.
[end_timeline]

label Partial
set {Variation} = range(1,4).pick_random()
if {Variation} == 1.0:
	ReynaMayari: Good. I still need [color=#0f6e2f]{Transaction_ItemWants}[/color].
elif {Variation} == 2.0:
	ReynaMayari: That covers part of it. Pass over [color=#0f6e2f]{Transaction_ItemWants}[/color] as well.
else:
	ReynaMayari: Almost done. Just add [color=#0f6e2f]{Transaction_ItemWants}[/color].
[end_timeline]

label Satisfy
if {Global_TipActive} == 1.0:
	ReynaMayari: Keep the extra coins, shopkeeper. Consider it a discreet daytime favor.
else:
	if {Transaction_SatisfyVar} < 34.0:
		ReynaMayari: Splendid. Remember, you never saw me here.
	elif {Transaction_SatisfyVar} < 67.0:
		ReynaMayari: Exactly what I craved. Keep the jars full, shopkeeper.
	else:
		ReynaMayari: Real mortal sweets beat silver banquets every time. Until later.
[signal arg="story_success"]
[end_timeline]

label Repayment
ReynaMayari: Here are your [color=#0f6e2f]{Transaction_RepaymentAmount}[/color] pesos. Cross Maria off the lista cleanly.
[signal arg="repay_debt"]
[end_timeline]

label WrongItem
ReynaMayari: That is not [color=#0f6e2f]{Transaction_ItemWants}[/color]. Try again, shopkeeper.
[end_timeline]
