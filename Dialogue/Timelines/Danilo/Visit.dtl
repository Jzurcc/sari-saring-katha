label Greeting
if {Transaction_HasReactiveOpener}:
	Danilo: {Transaction_ReactiveOpener}

if {Global_EventRumorActive}:
	Danilo: {Global_EventRumorText}
	Danilo: Keep that in mind, boss. Good business if you play it sharp.
	[signal arg="event_announced"]
	[signal arg="story_success"]
	[end_timeline]
elif {Global_RumorActive}:
	if {Global_RumorType} == 0.0:
		Danilo: Psst, boss. Saw {Global_LastCustomer} pass the tricycle stand looking pretty busy.
	else:
		Danilo: Uy, boss. {Global_LastCustomer} walked off happy with {Global_LastItem}. Good call.
	Danilo: Anyway, just checking the street. Stay sharp, 'no?
else:
	if {Transaction_VisitVar} < 34.0:
		Danilo: Uy, boss. Just borrowing your awning shade for two minutes. Best view of the road.
	elif {Transaction_VisitVar} < 67.0:
		Danilo: All quiet down by the creek bridge, boss. Folks sure love walking past your warm bulb.
	else:
		Danilo: Just a lazy tambay checking in, boss. Keep the cold bottles frosty, ha?
[signal arg="story_success"]
[end_timeline]

label Smalltalk
if {Transaction_VisitVar} < 34.0:
	Danilo: All clear down the street, boss. Nothing weird except how good your snacks smell.
elif {Transaction_VisitVar} < 67.0:
	Danilo: Good view of Karimlan from this bench. Stay sharp behind that counter, ha?
else:
	Danilo: Heading back to my shady post, boss. Holler if anyone gives you trouble.
[end_timeline]
