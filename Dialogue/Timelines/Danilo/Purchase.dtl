label Greeting
if {Transaction_HasReactiveOpener}:
	Danilo: {Transaction_ReactiveOpener}

if {Global_RumorActive}:
	if {Global_RumorType} == 0.0:
		Danilo: Psst, boss. {Global_LastCustomer} just walked past looking busy. Street never sleeps, 'no?
	else:
		Danilo: Uy, boss. Saw {Global_LastCustomer} leave with {Global_LastItem}. Good taste.

set {Variation} = range(1,5).pick_random()
if {Flag_DaniloWatchfulAlly}:
	if {Variation} == 1.0:
		Danilo: Road is all clear, boss. Pass me [color=#0f6e2f]{Transaction_ItemWants}[/color] for bench duty.
	elif {Variation} == 2.0:
		Danilo: Eyes finally rested for once! Sell me [color=#0f6e2f]{Transaction_ItemWants}[/color], boss.
	elif {Variation} == 3.0:
		Danilo: Front-row shade feels even better now. Grabbing [color=#0f6e2f]{Transaction_ItemWants}[/color].
	else:
		Danilo: Uy, boss. Fueling up the watch post with [color=#0f6e2f]{Transaction_ItemWants}[/color].
elif {Flag_DaniloEyesKnown}:
	if {Variation} == 1.0:
		Danilo: Bulbs are calmer on my eyes this pass. Pass over [color=#0f6e2f]{Transaction_ItemWants}[/color], boss.
	elif {Variation} == 2.0:
		Danilo: Still off the clock, boss. Just grabbing [color=#0f6e2f]{Transaction_ItemWants}[/color].
	elif {Variation} == 3.0:
		Danilo: Good breeze under your awning. Sell me [color=#0f6e2f]{Transaction_ItemWants}[/color].
	else:
		Danilo: Psst, boss. Slide over [color=#0f6e2f]{Transaction_ItemWants}[/color] before I lose my shade spot.
else:
	if {Variation} == 1.0:
		Danilo: Uy, boss. Buying [color=#0f6e2f]{Transaction_ItemWants}[/color] so I earn my awning shade.
	elif {Variation} == 2.0:
		Danilo: Watching the street works up an appetite. Pass me [color=#0f6e2f]{Transaction_ItemWants}[/color].
	elif {Variation} == 3.0:
		Danilo: Relax, boss, paying customer this pass. Grabbing [color=#0f6e2f]{Transaction_ItemWants}[/color].
	else:
		Danilo: Psst, boss. Let me snag [color=#0f6e2f]{Transaction_ItemWants}[/color] for the bench.

if {Transaction_WantsDebt} == 1.0:
	Danilo: Ah, left my coins in my other pants, boss. Can we put this on the lista?
	- Sure, I will list it, Danilo.
		[signal arg="utang_accepted"]
		Danilo: Lifesaver, boss. I will pay it back clean next pass.
	- Cash only this round, boss.
		[signal arg="utang_rejected"]
		Danilo: Fair call. Let me dig around my jacket pocket instead.
[end_timeline]

label Talk
Danilo: No hurry, boss. Still waiting on [color=#0f6e2f]{Transaction_ItemWants}[/color].
- Out of stock right now, Danilo.
	Danilo: Sayang. Catch you after Mario swings by, boss.
	[signal arg="refuse_service"]
- Coming right up!
	Danilo: Solid. I have all the time in the world.
[end_timeline]

label Partial
set {Variation} = range(1,4).pick_random()
if {Variation} == 1.0:
	Danilo: Nice one, boss. Still missing [color=#0f6e2f]{Transaction_ItemWants}[/color].
elif {Variation} == 2.0:
	Danilo: Got that! Just slide over [color=#0f6e2f]{Transaction_ItemWants}[/color] too.
else:
	Danilo: Almost set, boss. Still need [color=#0f6e2f]{Transaction_ItemWants}[/color].
[end_timeline]

label Satisfy
if {Global_TipActive} == 1.0:
	Danilo: Keep the extra coins, boss. Best shade in Karimlan.
else:
	if {Transaction_SatisfyVar} < 34.0:
		Danilo: Salamat, boss. See you from the corner!
	elif {Transaction_SatisfyVar} < 67.0:
		Danilo: Solid trade. I will keep an eye on the road for ya.
	else:
		Danilo: Perfect. Catch you on the next pass, boss.
[signal arg="story_success"]
[end_timeline]

label Repayment
Danilo: Found those missing coins, boss. Here is [color=#0f6e2f]{Transaction_RepaymentAmount}[/color] pesos for my lista!
[signal arg="repay_debt"]
[end_timeline]

label WrongItem
Danilo: Careful, boss. That is not [color=#0f6e2f]{Transaction_ItemWants}[/color]. Try again.
[end_timeline]
