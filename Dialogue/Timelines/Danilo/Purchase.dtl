label Greeting
# [signal arg="refresh_desires"]
if {Global_RumorActive}:
	if {Global_RumorType} == 0.0:
		Danilo: Psst. Boss. {Global_LastCustomer} just left? They looked... [pause=0.3] interesting.
	else:
		Danilo: Uy, boss. I saw {Global_LastCustomer} walking away with that {Global_LastItem}. Good choice on your part.
	[pause=0.4]
	Danilo: Anyway, I've been watching the stock levels... figured I'd snag something for myself for a change.
else:
	if {Transaction_GreetingVar} <= 50:
		Danilo: Uy, boss. Nice day today, 'no? Busy queue. [pause=0.4] I was thinking of actually buying something for a change.
	else:
		Danilo: Psst. Boss. High-quality inventory today, 'no? I've been watching the stock levels... figured I'd snag something.

if {Global_HighPriceActive}:
	Danilo: Medyo mataas ata ang markup natin ngayon ah? [pause=0.3] Sige lang, para naman sa ikauunlad ng tindahan niyo.

[end_timeline]

label Talk
if {Transaction_TalkVar} <= 50:
	Danilo: Give me a {Transaction_ItemWants}. I need to see if it's as good as they say.
else:
	Danilo: No rush, boss. I'm just here for a {Transaction_ItemWants}. I've got all the time in the world to watch.
- Coming right up.
	Danilo: Sige, boss. No hurry.
	[end_timeline]
- Sorry, Danilo, we're fresh out of stock.
	Danilo: Ah, sayang. Next time then. [pause=0.4] I'll go check the other store down the road. Peace!
	[signal arg="refuse_service"]
	[signal arg="story_success"]
	[end_timeline]


label Partial
Danilo: Nice one, boss. Still missing the {Transaction_ItemWants} though. Hit me.
[end_timeline]
[end_timeline]

label Satisfy
if {Transaction_SatisfyVar} <= 50:
	Danilo: Salamat, boss. [pause=0.4] See you on the high ground!
else:
	Danilo: Perfect. Exact change. [pause=0.5] I'll tell the guys at the tricycle stand you're doing a great job.
[end_timeline]

label WrongItem
if {Transaction_WrongItemVar} <= 50:
	Danilo: Uh... boss? That's not the {Transaction_ItemWants}. My eyes might be many, but they're not wrong.
else:
	Danilo: Ha! Careful, boss. You might be tired. This isn't the {Transaction_ItemWants}.
[end_timeline]
