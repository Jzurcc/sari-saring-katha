label Greeting
label CollectionIntro
if {Global_TallyRemaining} <= 0:
	jump SealedIntro
if {Global_MayariMet} == false:
	jump DebutIntro
set {Variation} = range(1,4).pick_random()
if {Global_LedgerTier} >= 4.0:
	# Tier 4 (75-99%): Near-sealed, Council watching closely
	if {Variation} == 1.0:
		ReynaMayari: Only [color=#2d527c]{Global_TallyRemaining}[/color] pesos left on Lola's Silver Ledger.
		ReynaMayari: Biringan's Council has stopped betting against you. Minimum is [color=#2d527c]{Global_TallyMin}[/color] pesos.
	elif {Variation} == 2.0:
		ReynaMayari: The final quarter of the ledger, shopkeeper. [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain.
		ReynaMayari: Offer at least [color=#2d527c]{Global_TallyMin}[/color] pesos, and let us see what the moon grants.
	else:
		ReynaMayari: Almost sealed. [color=#2d527c]{Global_TallyRemaining}[/color] pesos stand between you and a closed ledger.
		ReynaMayari: Set your share on the counter. At least [color=#2d527c]{Global_TallyMin}[/color] pesos.
elif {Global_LedgerTier} >= 3.0:
	# Tier 3 (50-74%): Halfway, Silver Favor unlocked
	if {Variation} == 1.0:
		ReynaMayari: Past the halfway mark. [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain on the ledger.
		ReynaMayari: The Council noticed I tilted your lunar odds. Make it worth my trouble. Minimum [color=#2d527c]{Global_TallyMin}[/color] pesos.
	elif {Variation} == 2.0:
		ReynaMayari: Your shelves look busier every shift. [color=#2d527c]{Global_TallyRemaining}[/color] pesos left of [color=#2d527c]{Global_TallyGoal}[/color].
		ReynaMayari: Place at least [color=#2d527c]{Global_TallyMin}[/color] pesos on the wood.
	else:
		ReynaMayari: Half the silver already recorded in Biringan. [color=#2d527c]{Global_TallyRemaining}[/color] pesos to go.
		ReynaMayari: Minimum is [color=#2d527c]{Global_TallyMin}[/color] pesos. Decide what you will offer.
elif {Global_LedgerTier} >= 2.0:
	# Tier 2 (30-49%): Daylight Audience unlocked (playful denial of daytime visits)
	if {Variation} == 1.0:
		ReynaMayari: Strictly Silver Ledger business. Do not bring up my daytime errands.
		ReynaMayari: [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain. I expect at least [color=#2d527c]{Global_TallyMin}[/color] pesos.
	elif {Variation} == 2.0:
		ReynaMayari: I see you restocked the candy jar. Irrelevant.
		ReynaMayari: [color=#2d527c]{Global_TallyRemaining}[/color] pesos left on Lola's ledger. Minimum is [color=#2d527c]{Global_TallyMin}[/color] pesos.
	else:
		ReynaMayari: Business first, shopkeeper. [color=#2d527c]{Global_TallyRemaining}[/color] of [color=#2d527c]{Global_TallyGoal}[/color] pesos remain.
		ReynaMayari: Set at least [color=#2d527c]{Global_TallyMin}[/color] pesos on the counter.
elif {Global_LedgerTier} >= 1.0:
	# Tier 1 (15-29%): First seal broken, Reroll unlocked
	if {Variation} == 1.0:
		ReynaMayari: The first seal broke cleanly. [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain on the ledger.
		ReynaMayari: Minimum is [color=#2d527c]{Global_TallyMin}[/color] pesos. Generosity still earns kinder Favors.
	elif {Variation} == 2.0:
		ReynaMayari: Word travels fast past the balete tree. You are steadier than Biringan expected.
		ReynaMayari: [color=#2d527c]{Global_TallyRemaining}[/color] pesos left. Set at least [color=#2d527c]{Global_TallyMin}[/color] pesos down.
	else:
		ReynaMayari: Time to weigh the counter, shopkeeper. [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain.
		ReynaMayari: At least [color=#2d527c]{Global_TallyMin}[/color] pesos, then draw your Moon Card.
else:
	# Tier 0 (0-14%): Early, brisk and regal
	if {Variation} == 1.0:
		ReynaMayari: Shutters closed, coins ready. [color=#2d527c]{Global_TallyRemaining}[/color] of [color=#2d527c]{Global_TallyGoal}[/color] pesos remain.
		ReynaMayari: I expect at least [color=#2d527c]{Global_TallyMin}[/color] pesos.
	elif {Variation} == 2.0:
		ReynaMayari: The Silver Ledger is open. [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain on Lola's pact.
		ReynaMayari: Offer at least [color=#2d527c]{Global_TallyMin}[/color] pesos, then face the Moon Cards.
	else:
		ReynaMayari: Count carefully, shopkeeper. [color=#2d527c]{Global_TallyRemaining}[/color] pesos still stand on the ledger.
		ReynaMayari: Minimum is [color=#2d527c]{Global_TallyMin}[/color] pesos. Decide your share.
[signal arg="open_tally_offer"]
[wait time="0.5"]
[end_timeline]

label DebutIntro
ReynaMayari: The candle by the counter is missing. Your Lola never forgot it once.
- Who are you?
	ReynaMayari: Reyna Mayari, Sovereign of Biringan. And you hold your grandmother's counter.
- Are you a late customer?
	ReynaMayari: Bold guess for a mortal. I am Mayari, Queen of Biringan.
- You knew my Lola?
	ReynaMayari: Better than most in Karimlan. I am Mayari of Biringan.
ReynaMayari: Your Lola signed a Silver Ledger with my city. [color=#2d527c]{Global_TallyGoal}[/color] pesos remain to seal it.
ReynaMayari: Each shift you pay, the moon answers with Favors for generosity, or Omens if you fall short.
ReynaMayari: Even a sharp shopkeeper can turn an Omen into profit. Place at least [color=#2d527c]{Global_TallyMin}[/color] pesos on the wood.
[signal arg="open_tally_offer"]
[wait time="0.5"]
[end_timeline]

label SealedIntro
set {Variation} = range(1,5).pick_random()
if {Variation} == 1.0:
	ReynaMayari: No coins owed, Patron. Keep your register closed and pick a lunar Favor instead.
elif {Variation} == 2.0:
	ReynaMayari: The Silver Ledger rests sealed in Biringan, yet I still drop by to bless your shelves.
elif {Variation} == 3.0:
	ReynaMayari: Keep your earnings, shopkeeper. Let us simply pick which Favor watches over your counter next.
else:
	ReynaMayari: Lola's pact is settled in full. Draw your Moon Card before you lock up.
[signal arg="open_tally_offer"]
[wait time="0.5"]
[end_timeline]

label Generous
set {Variation} = range(1,4).pick_random()
if {Variation} == 1.0:
	ReynaMayari: [color=#9a630a]{Global_TallyOffer}[/color] pesos. More than I asked, and [color=#2d527c]{Global_TallyRemaining}[/color] left on the ledger.
	ReynaMayari: The Silver Spires remember generosity. Enjoy your Favor.
elif {Variation} == 2.0:
	ReynaMayari: Generous coin, shopkeeper. [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain.
	ReynaMayari: Keep that pace up and Biringan's Council will run out of excuses.
else:
	ReynaMayari: [color=#9a630a]{Global_TallyOffer}[/color] pesos recorded in silver. Only [color=#2d527c]{Global_TallyRemaining}[/color] left.
	ReynaMayari: Your Lola used to slide extra coins over with that exact same grin.
[signal arg="check_mayari_milestones"]
[end_timeline]

label Success
set {Variation} = range(1,4).pick_random()
if {Variation} == 1.0:
	ReynaMayari: [color=#9a630a]{Global_TallyOffer}[/color] pesos recorded cleanly. [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain.
elif {Variation} == 2.0:
	ReynaMayari: Fair coin, shopkeeper. [color=#2d527c]{Global_TallyRemaining}[/color] pesos left on Lola's ledger.
else:
	ReynaMayari: Exact and orderly. [color=#2d527c]{Global_TallyRemaining}[/color] pesos remain before the pact seals.
[signal arg="check_mayari_milestones"]
[end_timeline]

label Shortfall
label Angry
if {Global_TallyOffer} <= 0:
	ReynaMayari: Nothing on the wood? [color=#2d527c]{Global_TallyRemaining}[/color] pesos still stand unpaid.
	ReynaMayari: Brace your shelves for a lunar Omen, shopkeeper.
else:
	ReynaMayari: Only [color=#9a630a]{Global_TallyOffer}[/color] pesos. Short of the mark, with [color=#2d527c]{Global_TallyRemaining}[/color] remaining.
	ReynaMayari: An Omen follows a light ledger. Let us see if you can profit from it anyway.
[signal arg="check_mayari_milestones"]
[end_timeline]

label MilestoneAlso
ReynaMayari: One more thing before I go.
[signal arg="check_mayari_milestones"]
[end_timeline]

label Milestone_reroll_1
ReynaMayari: You broke the first seal, [color=#9a630a]Moon's Grace[/color].
ReynaMayari: I will bend the court's rules just a little. Take one free [color=#9a630a]reroll[/color] on your Moon Cards from now on.
[signal arg="check_mayari_milestones"]
[end_timeline]

label Milestone_daytime_mayari
ReynaMayari: Thirty percent settled. You have earned [color=#9a630a]Daylight Audience[/color].
ReynaMayari: Expect me at your counter during business hours. Strictly to inspect the shop, of course.
[signal arg="check_mayari_milestones"]
[end_timeline]

label Milestone_shifted_odds_reroll_2
ReynaMayari: Half the Silver Ledger paid, [color=#9a630a]Silver Favor[/color] is yours.
ReynaMayari: I am tilting the lunar deck kindly toward Favors, and slipping you a [color=#9a630a]second reroll[/color]. Do not tell the Council.
[signal arg="check_mayari_milestones"]
[end_timeline]

label Milestone_twin_moons
ReynaMayari: Three-quarters honored. You have unlocked [color=#9a630a]Twin Moons[/color].
ReynaMayari: Claim up to [color=#9a630a]two Moon Cards[/color] at once from now on. You have earned the double blessing.
[signal arg="check_mayari_milestones"]
[end_timeline]

label LedgerCleared
ReynaMayari: Every last peso on Lola's Silver Ledger, settled in full.
if {Global_CompletedNeighborsCount} >= 3.0:
	ReynaMayari: And look down the road. Half of Karimlan is glowing with wards, warm lanterns, and goodwill.
	ReynaMayari: Biringan's Council cannot touch a street this alive. The Silver Pact is permanently sealed, friend.
else:
	ReynaMayari: Clean numbers, exact coin, not a centavo short. The Silver Pact is sealed by the letter of the law.
	ReynaMayari: Keep your earnings from now on, shopkeeper. Karimlan remains open beneath my watch.
[end_timeline]

label SealedOutro
set {Variation} = range(1,5).pick_random()
if {Variation} == 1.0:
	ReynaMayari: Sealed in silver. Rest well, Patron.
elif {Variation} == 2.0:
	ReynaMayari: Wise choice. Lock the shutters and get some sleep, shopkeeper.
elif {Variation} == 3.0:
	ReynaMayari: Done. Keep the candy jar full in case I drop by during business hours.
else:
	ReynaMayari: Your Favor is set. Lola would be grinning ear to ear right now.
[end_timeline]
