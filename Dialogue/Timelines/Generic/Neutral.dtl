label Greeting
# 1. Rumor Mill (Pasalubong) - 20% chance handled by StoryManager
if {Global.RumorActive}:
	if {Global.RumorType} == 0.0:
		Customer: I saw {Global.LastCustomer} earlier! [pause=0.3]
		Customer: Sabi niya ang bait mo raw dito sa tindahan. [pause=0.4]
	else:
		Customer: Oh, I ran into {Global.LastCustomer} just a moment ago. [pause=0.3]
		Customer: They were so happy with the [color=#0bb544][pulse]{Global.LastItem}[/pulse][/color] you sold them! [pause=0.5]

# 2. Riddle vs Normal Request
if {Transaction.IsRiddle}:
	Customer: I have a bit of a problem... [pause=0.4]
	Customer: I need something that [color=#0bb544][pulse]{Transaction.ItemHint}[/pulse][/color]. [pause=0.4]
	Customer: Do you have something that fits that description?
else:
	set {Variation} = range(1, 4).pick_random()
	if {Variation} == 1.0:
		Customer: Tao po! Good morning! [pause=0.3]
		Customer: Do you have any [color=#0bb544][pulse]{Transaction.ItemWants}[/pulse][/color] available today?
	elif {Variation} == 2.0:
		Customer: Hello po! [pause=0.3]
		Customer: Can I buy [color=#0bb544][pulse]{Transaction.ItemWants}[/pulse][/color], please?
	else:
		Customer: Hi there! Magandang araw. [pause=0.3]
		Customer: I'm just looking to buy some [color=#0bb544][pulse]{Transaction.ItemWants}[/pulse][/color] if you have some in stock.
[end_timeline]

label Talk
if {Transaction.IsRiddle}:
	Customer: Like I said, I'm looking for something that [color=#0bb544][pulse]{Transaction.ItemHint}[/pulse][/color].
	- Sige, sandali lang.
		Customer: Sige po, wait muna ako rito.
		[end_timeline]
	- Sorry, wala kaming ganyan.
		Customer: Ganoon ba? Sige, [pause=0.4] salamat na lang po.
		[signal arg="refuse_service"]
		[end_timeline]
else:
	set {Variation} = range(1, 4).pick_random()
	if {Variation} == 1.0:
		Customer: Just the [color=#0bb544][pulse]{Transaction.ItemWants}[/pulse][/color], please! Take your time.
		- Sige, sandali lang.
			Customer: Okay po, I'll be right here.
			[end_timeline]
		- Sorry, wala nang stock.
			Customer: Ay, out of stock ba? Sayang.
			Customer: That's okay, I'll just check again tomorrow. [pause=0.4] [pulse]Salamat![/pulse]
			[signal arg="refuse_service"]
			[end_timeline]
	elif {Variation} == 2.0:
		Customer: Ay, I was asking for [color=#0bb544][pulse]{Transaction.ItemWants}[/pulse][/color]. Did you forget already? Haha!
		- Sige, sandali lang.
			Customer: Sige po, no rush! I know you're busy.
			[end_timeline]
		- Sorry, wala nang stock.
			Customer: Wala na po? Aww, okay.
			Customer: I'll just look somewhere else then. [pause=0.4] [pulse]Bye po![/pulse]
			[signal arg="refuse_service"]
			[end_timeline]
	else:
		Customer: Still waiting on the [color=#0bb544][pulse]{Transaction.ItemWants}[/pulse][/color] po. No rush!
		- Sige, sandali lang.
			Customer: Sure thing! Take your time.
			[end_timeline]
		- Sorry, wala nang stock.
			Customer: Naku, ubos na? Pa-reserve ako next time ha!
			Customer: Sige, [pulse]salamat[/pulse] na lang po.
			[signal arg="refuse_service"]
			[end_timeline]

label Partial
Customer: [pulse]Salamat![/pulse] [pause=0.3]
Customer: I still need [color=#0bb544][pulse]{Transaction.ItemWants}[/pulse][/color] though.
[end_timeline]

label Satisfy
# Handle Utang (Debt) Choice - 15% chance
if {Transaction.WantsDebt}:
	Customer: [pulse]Maraming salamat![/pulse] [pause=0.5]
	Customer: [wave]Naku...[/wave] [pause=0.4] I just realized I forgot my wallet at home.
	Customer: Is it okay if I take this on [color=#0bb544][pulse]utang[/pulse][/color] for now? [pause=0.4] Babayaran ko rin bukas, promise!
	- Sige, no problem. (Accept Debt)
		[signal arg="utang_accepted"]
		Customer: Wow, talagang napakabait mo! [pause=0.3] Maraming salamat talaga.
		Customer: I'll see you tomorrow po!
	- Sorry, strictly no credit today. (Refuse Debt)
		[signal arg="utang_rejected"]
		Customer: Ah... [pause=0.4] ganoon ba? Sige, [pause=0.3] maiiwan ko muna 'to rito.
		Customer: Babalik na lang ako 'pag dala ko na 'yung pera. [pause=0.4] Salamat pa rin!
else:
	set {Variation} = range(1, 4).pick_random()
	if {Variation} == 1.0:
		Customer: [pulse]Maraming salamat![/pulse] You're a lifesaver.
		Customer: Have a great day!
	elif {Variation} == 2.0:
		Customer: Perfect, just what I needed.
		Customer: Salamat po! I'll definitely come back next time.
	else:
		Customer: Got it! Salamat!
		Customer: Ingat palagi dito sa tindahan.
[end_timeline]

label WrongItem
if {Transaction.IsRiddle}:
	Customer: Hmm... [pause=0.4] hindi po yata ito 'yung nakakatulong sa description ko.
	Customer: Pwede bang patingin ng iba?
else:
	set {Variation} = range(1, 4).pick_random()
	if {Variation} == 1.0:
		Customer: Ay, I think there's a mix-up.
		Customer: This isn't the [color=#4a6741][pulse]{Transaction.ItemWants}[/pulse][/color] I asked for!
	elif {Variation} == 2.0:
		Customer: Hmm, wait lang.
		Customer: I asked for [color=#4a6741][pulse]{Transaction.ItemWants}[/pulse][/color], not this one po.
	else:
		Customer: Naku, hindi po ito 'yun.
		Customer: Can you double-check? I needed [color=#0bb544][pulse]{Transaction.ItemWants}[/pulse][/color].
[end_timeline]
