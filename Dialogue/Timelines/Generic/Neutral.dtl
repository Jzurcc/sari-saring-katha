label Greeting

# 0. Stock Awareness - 40% chance handled by StoryManager
if {Global.AwarenessActive}:
	if {Global.StockStatus} == "Empty":
		Customer: Tao po? [pause=0.3] Napansin ko lang po, parang wala na kayong tinda?
	elif {Global.StockStatus} == "Low":
		Customer: Hello po! [pause=0.3] Naku, parang paubos na ang stock niyo ah.
	else:
		Customer: Hi there! [pause=0.3] Nice to see your shelves are so full today!

# 1. Price Sensitivity - 40% chance if set in StoryManager
if {Global.HighPriceActive}:
	set {PriceVar} = range(1, 4).pick_random()
	if {PriceVar} == 1.0:
		Customer: Naku, ang taas na ng presyo niyo ngayon ah?
	elif {PriceVar} == 2.0:
		Customer: Grabe, ang mahal na yata ng mga tinda niyo ngayon.
	else:
		Customer: Is it just me, or are things more expensive here today?

# 1. Rumor Mill (Pasalubong) - 20% chance handled by StoryManager
if {Global.RumorActive}:
	if {Global.RumorType} == 0.0:
		Customer: I saw {Global.LastCustomer} earlier! [pause=0.3]
		Customer: Sabi niya ang bait mo raw dito sa tindahan. [pause=0.4]
	else:
		Customer: Oh, I ran into {Global.LastCustomer} just a moment ago. [pause=0.3]
		Customer: They were so happy with the [color=#0f6e2f]{Global.LastItem}[/color] you sold them! [pause=0.5]

# 2. Riddle vs Normal Request
if {Transaction.IsRiddle}:
	Customer: I have a bit of a problem... [pause=0.4]
	Customer: I need something that [color=#0f6e2f]{Transaction.ItemHint}[/color].
	if {Transaction.RemainingCount} > 1:
		Customer: Oh, and also some [color=#0f6e2f]{Transaction.ItemWants}[/color] po. [pause=0.4]
	Customer: Do you have those for me?
else:
	set {Variation} = range(1, 4).pick_random()
	if {Variation} == 1.0:
		Customer: Tao po! Hello po! [pause=0.3]
		Customer: Do you have any [color=#0f6e2f]{Transaction.ItemWants}[/color] available today?
	elif {Variation} == 2.0:
		Customer: Hello po! [pause=0.3]
		Customer: Can I buy [color=#0f6e2f]{Transaction.ItemWants}[/color], please?
	else:
		Customer: Hi there! Kumusta po? [pause=0.3]
		Customer: I'm just looking to buy some [color=#0f6e2f]{Transaction.ItemWants}[/color] if you have some in stock.
[end_timeline]

label Talk
if {Transaction.DeliveredCount} > 0:
	Customer: Like I said, I still need [color=#0f6e2f]{Transaction.ItemWants}[/color] po.
	- Sige, kukunin ko na.
		Customer: Sige po, I'll wait here.
		[end_timeline]
	- Pasensya na, iyan lang muna.
		Customer: Oh... iyan lang po? Sige, [pause=0.3] iyan na lang muna. Salamat!
		[signal arg="partial_dismiss"]
		[end_timeline]
elif {Transaction.IsRiddle}:
	Customer: Like I said, I'm looking for something that [color=#0f6e2f]{Transaction.ItemHint}[/color].
	- Sige, sandali lang.
		Customer: Sige po, wait muna ako rito.
		[end_timeline]
	- Sorry, wala kaming ganyan.
		Customer: Ganoon ba? Sige, [pause=0.4] salamat na lang po.
		[signal arg="refuse_service"]
		[end_timeline]
else:
	set {Variation} = range(1, 4).pick_random()
	if {Variation} == 1.0:
		Customer: Just the [color=#0f6e2f]{Transaction.ItemWants}[/color], please! Take your time.
		- Sige, sandali lang.
			Customer: Okay po, I'll be right here.
			[end_timeline]
		- Sorry, wala nang stock.
			Customer: Ay, out of stock ba? Sayang.
			Customer: That's okay, I'll just check again tomorrow. [pause=0.4] Salamat!
			[signal arg="refuse_service"]
			[end_timeline]
	elif {Variation} == 2.0:
		Customer: Ay, I was asking for [color=#0f6e2f]{Transaction.ItemWants}[/color]. Did you forget already? Haha!
		- Sige, sandali lang.
			Customer: Sige po, no rush! I know you're busy.
			[end_timeline]
		- Sorry, wala nang stock.
			if {Transaction.DeliveredCount} > 0:
				Customer: Naku, wala na po 'yung iba? Sige, [pause=0.3] iyan na lang po.
				[signal arg="partial_dismiss"]
			else:
				Customer: Wala na po? Aww, okay.
				Customer: I'll just look somewhere else then. [pause=0.4] Bye po!
				[signal arg="refuse_service"]
			[end_timeline]
	else:
		Customer: Still waiting on the [color=#0f6e2f]{Transaction.ItemWants}[/color] po. No rush!
		- Sige, sandali lang.
			Customer: Sure thing! Take your time.
			[end_timeline]
		- Sorry, wala nang stock.
			if {Transaction.DeliveredCount} > 0:
				Customer: Ubos na 'yung iba? Sayang. I'll just take these then. Salamat!
				[signal arg="partial_dismiss"]
			else:
				Customer: Naku, ubos na? Pa-reserve ako next time ha!
				Customer: Sige, salamat na lang po.
				[signal arg="refuse_service"]
			[end_timeline]

label PartialDismiss
Customer: Sige po, iyan na lang muna. [pause=0.3] Salamat pa rin sa tulong!
[end_timeline]

label Partial
Customer: Salamat! [pause=0.3]
if {Transaction.IsRiddle}:
	Customer: I still need the one that [color=#0f6e2f]{Transaction.ItemHint}[/color].
if {Transaction.RemainingCount} > 0 and not {Transaction.IsRiddle}:
	Customer: I still need [color=#0f6e2f]{Transaction.ItemWants}[/color] though.
[end_timeline]

label Satisfy
# Handle Utang (Debt) Choice - 15% chance
if {Transaction.WantsDebt}:
	Customer: Maraming salamat! [pause=0.5]
	Customer: [wave]Naku...[/wave] [pause=0.4] I just realized I forgot my wallet at home.
	Customer: Is it okay if I take this on [color=#0f6e2f]utang[/color] for now? [pause=0.4] Babayaran ko rin bukas, promise!
	- Sige, no problem. (Accept Debt)
		[signal arg="utang_accepted"]
		Customer: Wow, talagang napakabait mo! [pause=0.3] Maraming salamat talaga.
		Customer: I'll see you tomorrow po!
	- Sorry, strictly no credit today. (Refuse Debt)
		[signal arg="utang_rejected"]
		Customer: Ah... [pause=0.4] ganoon ba? Sige, [pause=0.3] maiiwan ko muna 'to rito.
		Customer: Babalik na lang ako 'pag dala ko na 'yung pera. [pause=0.4] Salamat pa rin!
else:
	set {Variation} = range(1, 4).pick_random()
	if {Variation} == 1.0:
		Customer: Maraming salamat! You're a lifesaver.
		Customer: Ingat po!
	elif {Variation} == 2.0:
		Customer: Perfect, just what I needed.
		Customer: Salamat po! I'll definitely come back next time.
	else:
		Customer: Got it! Salamat!
		Customer: Ingat palagi dito sa tindahan.
[end_timeline]

label WrongItem
if {Transaction.IsRiddle}:
	Customer: Hmm... [pause=0.4] hindi po yata ito 'yung nakakatulong sa description ko.
	Customer: Pwede bang patingin ng iba?
else:
	set {Variation} = range(1, 4).pick_random()
	if {Variation} == 1.0:
		Customer: Ay, I think there's a mix-up.
		Customer: This isn't the [color=#4a6741]{Transaction.ItemWants}[/color] I asked for!
	elif {Variation} == 2.0:
		Customer: Hmm, wait lang.
		Customer: I asked for [color=#4a6741]{Transaction.ItemWants}[/color], not this one po.
	else:
		Customer: Naku, hindi po ito 'yun.
		Customer: Can you double-check? I needed [color=#0f6e2f]{Transaction.ItemWants}[/color].
[end_timeline]
