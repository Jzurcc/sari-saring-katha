label Greeting
# [signal arg="refresh_desires"]
# 0. Stock Awareness - 40% chance
if {Global_AwarenessActive}:
	if {Global_StockStatus} == "Empty":
		Customer: Tao po? [pause=0.3] Parang wala na kayong tinda po ah?
	elif {Global_StockStatus} == "Low":
		Customer: Hello po! [pause=0.3] Napansin ko lang, parang kakaunti na lang ang stock niyo ah.
	else:
		Customer: Hi there! [pause=0.3] Looks like you're fully stocked today!

# 1. Price Sensitivity - 50% chance if set in StoryManager
if {Global_HighPriceActive}:
	if {Transaction_CustomerName} == "Kuya Kap":
		KuyaKap: Hala, apo. Parang medyo masakit ata sa bulsa 'to ngayon ah? [pause=0.3] Tumataas na talaga presyo ng bilihin.
	elif {Transaction_CustomerName} == "Manang Ana":
		ManangAna: Jusko, pati ba naman dito? [pause=0.4] Ang mahal na talaga ng mabuhay ngayon, anak. Konting bawas naman sana.
	elif {Transaction_CustomerName} == "Buboy":
		Buboy: Kuya, bakit po ang mahal? [pause=0.3] Baka hindi na po ako payagan ni Mama bumili next time.
	elif {Transaction_CustomerName} == "Danilo":
		Danilo: Medyo mataas ata ang markup natin ngayon ah? [pause=0.3] Sige lang, para naman sa ikauunlad ng tindahan niyo.
	elif {Transaction_CustomerName} == "Rodel":
		Rodel: This... this is quite steep for a local shop, don't you think? [pause=0.3] I expected more competitive pricing.
	elif {Transaction_CustomerName} == "Rosalyn":
		Rosalyn: Ang bigat naman po yata ng halaga nito ngayon... [pause=0.4] Parang dati mas madaling makuha.
	elif {Transaction_CustomerName} == "TK":
		TK: Whoa, premium prices for a premium sari-sari experience? [pause=0.4] I'll have to mention this in the vlog... if I can afford it!
	elif {Transaction_CustomerName} == "Brahim":
		Brahim: Ang mahal naman... [pause=0.3] Isang araw na ulam na rin ang presyo nito.
	elif {Transaction_CustomerName} == "Reyna Mayari":
		ReynaMayari: The value you place on these items is... [pause=0.4] ambitious. I trust the quality justifies it.
	elif {Transaction_CustomerName} == "Sarimanok":
		Sarimanok: Expensive? Cheap? To a bird of gold, these are but earthly trifles... [pause=0.4] but my human friends might not agree.
	else:
		Customer: High prices today, huh? [pause=0.3] Economy must be tough.
# 1. Main Request
if {Transaction_IsRiddle}:
	Customer: I'm looking for something that [color=#0f6e2f]{Transaction_ItemHint}[/color].
	Customer: Do you have anything like that in stock?
else:
	# 10 Randomized English-focused Variations
	if {Transaction_GreetingVar} < 10:
		Customer: Tao po! [pause=0.3] I was just passing by. Do you have any [color=#0f6e2f]{Transaction_ItemWants}[/color] available?
	elif {Transaction_GreetingVar} < 20:
		Customer: Hello! [pause=0.3] I'm looking for some [color=#0f6e2f]{Transaction_ItemWants}[/color]. Do you have those today?
	elif {Transaction_GreetingVar} < 30:
		Customer: Hi! [pause=0.3] I heard you have a nice stock of [color=#0f6e2f]{Transaction_ItemWants}[/color]. Can I buy some?
	elif {Transaction_GreetingVar} < 40:
		Customer: Good day! [pause=0.3] I need to pick up some [color=#0f6e2f]{Transaction_ItemWants}[/color]. Hope you have them in stock!
	elif {Transaction_GreetingVar} < 50:
		Customer: Excuse me! [pause=0.3] I'm in a bit of a rush. Can I get some [color=#0f6e2f]{Transaction_ItemWants}[/color], please?
	elif {Transaction_GreetingVar} < 60:
		Customer: Hello po! [pause=0.3] I was wondering if you have any [color=#0f6e2f]{Transaction_ItemWants}[/color] for sale?
	elif {Transaction_GreetingVar} < 70:
		Customer: Hi there! [pause=0.3] Just checking if you have [color=#0f6e2f]{Transaction_ItemWants}[/color] available right now.
	elif {Transaction_GreetingVar} < 80:
		Customer: Tao po! [pause=0.3] I'm looking for some [color=#0f6e2f]{Transaction_ItemWants}[/color] to take home. Do you have any?
	elif {Transaction_GreetingVar} < 90:
		Customer: Hello! [pause=0.3] I'd like to buy some [color=#0f6e2f]{Transaction_ItemWants}[/color] if they're available.
	else:
		Customer: Hi! [pause=0.3] Do you have any [color=#0f6e2f]{Transaction_ItemWants}[/color] ready for pick up?
[end_timeline]

label Talk
if {Transaction_IsRiddle}:
	Customer: I'm still waiting for the item that [color=#0f6e2f]{Transaction_ItemHint}[/color] po. No rush!
else:
	Customer: I'm still waiting for the [color=#0f6e2f]{Transaction_ItemWants}[/color] po. No rush!
- Sige, wait for a bit.
	Customer: Sure, I'll wait here.
	[end_timeline]
- Sorry, we're fresh out of stock.
	Customer: Oh... is that so? [pause=0.4] Sige po, I'll just check again tomorrow. Salamat!
	[signal arg="refuse_service"]
	[signal arg="story_success"]
	[end_timeline]

label Satisfy
if {Transaction_WantsDebt}:
	Customer: Thank you so much! [pause=0.5]
	Customer: [wave]Oh...[/wave] [pause=0.4] I just realized I forgot my wallet at home.
	Customer: Is it okay if I take this on [color=#0f6e2f]utang[/color] for now? [pause=0.4] I'll pay you back tomorrow, I promise!
	- Sure, no problem.
		[signal arg="utang_accepted"]
		Customer: Wow, you're so kind! [pause=0.3] Thank you so much!
		Customer: I'll see you tomorrow!
	- Sorry, no credit today.
		[signal arg="utang_rejected"]
		Customer: Oh... [pause=0.4] I see. [pause=0.3] I'll just leave these here for now then.
		Customer: I'll come back when I have my money. [pause=0.4] Thanks anyway!
else:
	Customer: Thank you so much! [pause=0.4] This is exactly what I needed.
	Customer: Sige po, I'll head out now. Ingat!
[signal arg="story_success"]
[end_timeline]

label WrongItem
if {Transaction_IsRiddle}:
	Customer: Hmm... [pause=0.4] I don't think this [color=#0f6e2f]{Transaction_ItemHint}[/color].
else:
	Customer: Hmm... [pause=0.4] I don't think this is the [color=#4a6741]{Transaction_ItemWants}[/color] I asked for.
Customer: Can you double-check please?
[end_timeline]
