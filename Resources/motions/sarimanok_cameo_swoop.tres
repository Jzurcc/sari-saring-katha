[gd_resource type="Resource" script_class="CustomerMotionProfile" format=3]

[ext_resource type="Script" path="res://Scripts/Data/CustomerMotionProfile.gd" id="1_profile"]
[ext_resource type="Script" path="res://Scripts/Data/CustomerMotionStep.gd" id="2_step"]

[sub_resource type="Resource" id="step_1"]
script = ExtResource("2_step")
anchor = 2
local_offset = Vector3(0, 1.8, -3.2)
duration = 1.65
transition = 1
ease_type = 1
height_arc = 0.9
target_opacity = 1.0

[sub_resource type="Resource" id="step_2"]
script = ExtResource("2_step")
anchor = 5
local_offset = Vector3(1.5, 2.8, -2.5)
duration = 1.75
transition = 1
ease_type = 0
height_arc = 0.8
target_opacity = 0.0

[resource]
script = ExtResource("1_profile")
