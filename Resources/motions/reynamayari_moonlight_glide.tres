[gd_resource type="Resource" script_class="CustomerMotionProfile" format=3]

[ext_resource type="Script" path="res://Scripts/Data/CustomerMotionProfile.gd" id="1_profile"]
[ext_resource type="Script" path="res://Scripts/Data/CustomerMotionStep.gd" id="2_step"]

[sub_resource type="Resource" id="enter_1"]
script = ExtResource("2_step")
anchor = 2
local_offset = Vector3(0, 0, 0)
duration = 2.35
transition = 1
ease_type = 1
target_opacity = 1.0

[sub_resource type="Resource" id="exit_1"]
script = ExtResource("2_step")
anchor = 7
local_offset = Vector3(0, 0.35, -1.8)
duration = 1.85
transition = 1
ease_type = 0
target_opacity = 0.0

[resource]
script = ExtResource("1_profile")
profile_name = "Reyna Mayari Moonlight Glide"
locomotion_style = 1
base_speed = 1.35
bob_frequency = 3.6
bob_amplitude = 0.045
sway_amount = 0.015
idle_height_offset = 0.16
idle_bob_amplitude = 0.04
idle_bob_speed = 1.8
idle_sway_amount = 0.01
idle_opacity = 1.0
play_landing_thud = false
override_start_anchor = true
start_anchor = 0
start_offset = Vector3(0, 0.25, 1.2)
start_opacity = 0.0
enter_steps = Array[ExtResource("2_step")]([SubResource("enter_1")])
exit_steps = Array[ExtResource("2_step")]([SubResource("exit_1")])
bypass_default_exit_stepback = true
