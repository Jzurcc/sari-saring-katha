target_opacity = 1.0
pause_after = 0.75
pause_random_extra = 0.4

[sub_resource type="Resource" id="enter_2"]
script = ExtResource("2_step")
anchor = 2
local_offset = Vector3(0, 0, 0)
duration = 1.25
transition = 1
ease_type = 2
target_opacity = 1.0

[resource]
script = ExtResource("1_profile")
