[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "summer_heat"
event_name = "Intense Heatwave"
description = "Blistering heat strains your cooler while everyone begs for cold drinks."
rumor_text = "Even the stray dogs are hiding under tricycles! Watch your fridge coldness while everyone begs for cold bottles and sweets."
icon_path = "res://Assets/ui/icons/thermometer-sun.png"
affected_categories = Array[String](["bottle", "candy", "sachet"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 2.4
tolerance_offset = 2
fridge_drain_multiplier = 1.25
