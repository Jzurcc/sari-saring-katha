[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "typhoon_warning"
event_name = "Typhoon Warning"
description = "A storm is coming—neighbors stock up on rations as roads slow."
rumor_text = "Psst. Boss. Heavy clouds rolling in over the hills. Word from the terminal is Signal No. 1 tonight. Folks are grabbing multi-item bundles of canned goods, noodles, and coffee before the rain hits."
icon_path = "res://Assets/ui/icons/cloud-rain.png"
affected_categories = Array[String](["can", "sachet", "pack"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 2.5
tolerance_offset = 2
multi_item_chance_bonus = 0.25
delivery_cooldown_multiplier = 1.25
