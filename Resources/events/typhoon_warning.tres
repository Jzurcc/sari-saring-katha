[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "typhoon_warning"
event_name = "Signal No. 1 Advisory"
description = "Storm clouds slow deliveries while households bundle pantry staples."
rumor_text = "Dark clouds over the hills, mga kapitbahay! Mario's deliveries run slower while households bundle canned goods, frozen ulam, and packs."
icon_path = "res://Assets/ui/icons/cloud-rain.png"
affected_categories = Array[String](["can", "frozen", "pack"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 2.3
tolerance_offset = 2
multi_item_chance_bonus = 0.20
delivery_cooldown_multiplier = 1.20
roll_weight = 0.65
