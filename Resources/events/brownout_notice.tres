[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "brownout_notice"
event_name = "Scheduled Brownout"
description = "Line maintenance strains your cooler while neighbors bundle pantry staples."
rumor_text = "Linemen are cutting power for repairs soon! Watch your cooler while folks bundle up canned food, noodles, and smokes."
icon_path = "res://Assets/ui/icons/zap.png"
affected_categories = Array[String](["can", "pack", "cigarette"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 2.0
tolerance_offset = 2
multi_item_chance_bonus = 0.15
fridge_drain_multiplier = 1.25
