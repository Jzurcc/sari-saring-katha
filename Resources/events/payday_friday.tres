[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "payday_friday"
event_name = "Payday Rush"
description = "Workers in town just received their payroll. Customers have extra cash and are willing to spend on premium snacks and canned meats."
rumor_text = "Uy, boss. Folks from town just got their payroll packets today. Pockets are full for once, so don't be shy about stocking up the snacks and good canned meat."
affected_categories = ["snack", "can", "pack"]
affected_items = []
demand_multiplier = 2.0
tolerance_offset = 1
