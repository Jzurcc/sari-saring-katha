[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "payday_friday"
event_name = "Payday Rush"
description = "Workers in town just received their payroll. Customers have fuller pockets, buy snacks and canned goods freely, and leave generous tips."
rumor_text = "Uy, boss. Folks from town just got their payroll packets today. Pockets are full for once, so don't be shy about stocking up snacks and canned meat—they're tipping extra too!"
icon_path = "res://Assets/ui/icons/banknote.png"
affected_categories = Array[String](["snack", "can", "pack"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 2.0
tolerance_offset = 1
tip_bonus_pct = 0.10
