[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "payday_friday"
event_name = "Payday Rush"
description = "Payroll just hit and neighbors are spending freely across every shelf."
rumor_text = "Payroll envelopes just landed! Pockets are full across Karimlan, and families are treating themselves to frozen ulam and tins."
icon_path = "res://Assets/ui/icons/banknote.png"
affected_categories = Array[String](["frozen", "can", "pack"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 2.0
tolerance_offset = 1
tip_bonus_pct = 0.10
global_tolerance_offset = 1
roll_weight = 0.60
