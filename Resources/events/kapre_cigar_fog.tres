[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "kapre_cigar_fog"
event_name = "Kapre's Smoke Drift"
description = "Warm mahogany smoke drifts down from the old acacia, packing your counter with an extra slot and generous tips."
rumor_text = "Amoy tabako galing sa lumang akasya... Must be the old Kapre relaxing! Expect a packed counter and generous tips on drinks, yosi, and canned goods."
