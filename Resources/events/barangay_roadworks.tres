[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "barangay_roadworks"
event_name = "Highway Roadworks"
description = "Highway detours slow deliveries while stranded commuters stop by."
rumor_text = "Traffic advisory! Roadworks slowed Uncle Mario's crates down, though stranded commuters are leaning on local counters."
icon_path = "res://Assets/ui/icons/construction.png"
affected_categories = Array[String](["can", "sachet", "bottle"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 1.6
tolerance_offset = 2
xp_multiplier = 1.15
restock_cost_multiplier = 1.08
delivery_cooldown_multiplier = 1.25
