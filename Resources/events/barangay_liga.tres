[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "barangay_liga"
event_name = "Barangay Basketball Finals"
description = "The championship game at the covered court is today. Thirsty players and loud spectators are pouring past your tindahan."
rumor_text = "Uy, boss. Covered court is packed today. Championship match of the barangay league. Whole neighborhood's gonna be parched and looking for cold drinks and snacks after the buzzer."
icon_path = "res://Assets/ui/icons/trophy.png"
affected_categories = Array[String](["snack", "bottle"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 2.5
tolerance_offset = 2
foot_traffic_scale = 0.85
