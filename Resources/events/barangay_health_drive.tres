[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "barangay_health_drive"
event_name = "Barangay Clean-Up Drive"
description = "Volunteers are tidying Karimlan! Community goodwill grants bonus Player XP on every customer and a small barangay wholesale discount."
rumor_text = "Volunteers are out with walis tingting across Karimlan today, boss! Supporting the barangay clean-up earns you extra goodwill XP, plus a small discount from local suppliers."
icon_path = "res://Assets/ui/icons/heart-pulse.png"
affected_categories = Array[String](["bottle", "sachet"])
affected_items = Array[Resource("res://Scripts/Data/ItemData.gd")]([])
demand_multiplier = 1.8
tolerance_offset = 1
xp_multiplier = 1.25
restock_cost_multiplier = 0.90
