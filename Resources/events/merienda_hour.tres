[gd_resource type="Resource" script_class="StoreEventData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Data/StoreEventData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
event_id = "merienda_hour"
event_name = "Merienda Craze"
description = "Everyone is craving afternoon merienda bundles today."
rumor_text = "Smells like hot water and noodles all over the block, boss. Folks are in a merienda mood today—expect plenty of combo orders for coffee sachets, snacks, and pancit packs."
