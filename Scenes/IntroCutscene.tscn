[node name="Sequence_Court" type="Node" parent="Sequences" unique_id=1097537286]
script = ExtResource("2_seq")
subtitle_text = "It is a quiet town. The kind of place where time slows down, and the neighbors share old stories over a cold bottle of cola as the day ends."

