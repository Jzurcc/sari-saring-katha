[node name="Sequence_Road" type="Node" parent="Sequences" unique_id=317748420]
script = ExtResource("2_seq")
subtitle_text = "The deafening roar of the city finally gives way to the whispering winds of Karimlan. You left the corporate grind behind, trading the concrete maze for the fading warmth of a sunset from your province."

