[node name="Sequence_Forest" type="Node" parent="Sequences" unique_id=13669309]
script = ExtResource("2_seq")
subtitle_text = "But as the sun dips below the trees, Karimlan reveals its true nature. Here, the myths don't hide in the dark. They walk the streets right beside us."

